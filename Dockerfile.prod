# Multi-stage build for bun-based Next.js app
FROM oven/bun:1.2.10-alpine AS base

# Install system dependencies
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./
COPY apps/web/package.json ./apps/web/
COPY turbo.json ./

# Install dependencies
FROM base AS deps
RUN cd apps/web && bun install --frozen-lockfile

# Build stage
FROM base AS builder
COPY . .
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules

# Build the application
WORKDIR /app/apps/web
RUN bun run build

# Production stage
FROM oven/bun:1.2.10-alpine AS runner
WORKDIR /app

# Install PM2 for process management
RUN bun add -g pm2

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built application
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

# Create PM2 ecosystem config
RUN echo 'module.exports = {\n\
  apps: [{\n\
    name: "nextjs-server",\n\
    script: "./apps/web/server.js",\n\
    instances: 1,\n\
    exec_mode: "cluster",\n\
    env: {\n\
      NODE_ENV: "production",\n\
      PORT: 3000\n\
    }\n\
  }]\n\
}' > ecosystem.config.js

# Change ownership
RUN chown -R nextjs:nodejs /app
USER nextjs

# Expose ports
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD bun --version || exit 1

# Start application
CMD ["pm2-runtime", "start", "ecosystem.config.js"]